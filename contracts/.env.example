# Quiver deploy configuration — copy to .env and fill in the secrets.
# Robinhood Chain (id 4663) Uniswap v4 infrastructure.

RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- Uniswap v4 infra on Robinhood Chain (chain 4663) ---
POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951
POSITION_MANAGER=0x58daec3116aae6D93017bAAea7749052E8a04fA7
PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3

# --- Deploy identity ---
# The address allowed to call seed() once (ownership is renounced inside seed()).
HOOK_OWNER=0xYourDeployerAddress
# Deployer private key (never commit the real .env).
PK=0xYourPrivateKey

# --- Seed (launch) parameters, set after Deploy prints the hook address ---
HOOK=0xDeployedQuiverHookAddress
TICK_LOWER=-6000
TICK_UPPER=0
